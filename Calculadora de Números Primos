def recomecar():
    global n
    global primo
    global calculo
    print("Insira um número maior que o anterior:")
    primo = n + 1
    n = int(input())
    if n < ultn:
        print("O número inserido é menor que o anterior")
        print("Por favor insira um número maior que o anterior:")
        n = int(input())
        recomecar()
    else:
        calculo = True
    # Para adicionar mais numeros a serem primos


while calculo == True:
    if primo <= n:
        intounao = primo / divisor
        if intounao == 1:
            print(primo, " é primo!")
            primo += 1
            divisor = 2
            continue
        elif primo % divisor == 0:
            primo += 1
            divisor = 2
            continue
        elif primo % divisor != 0:
            divisor += 1
            continue
    elif primo > n:
        print(f"Esses são os números primos até {n}!")
        print("Agora escolha mais números para que eu possa calcular")
