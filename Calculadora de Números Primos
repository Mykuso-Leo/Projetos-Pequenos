# Então o programa começa o 4 por todos os números de 2 até 4 por

# número dado pelo usuário como até onde os primos devem ser calculados
n = 0

# número inicial que dita qual número está sendo testado se é inteiro ou nao
primo = 5

# número que começa no 2 e vai dividindo o primo até ser igual a ele
divisor = 2

# quociente da divisão do primo pelo divisor
# se for inteiro, a variável primo não é primo, deve ser testado até ser igual a 1
# quando int = 1 significa que o programa calculou até o final e o primo é primo
intounao = 0

ultn = 10

calculo = False
bemvindo = True
bemvindo2 = False

while bemvindo == True:
    bemvindo = False
    print("Bem vindo à calculadora de números primos!")
    print("Selecione até que número você quer calcular e direi quais números são primos.")
    print("Por favor escolha um número igual ou maior que 10:")
    n = int(input())
    if n < 10:
        bemvindo2 = True
        continue
    elif n >= 10:
        print("2 é primo!")
        print("3 é primo!")
        calculo = True

while bemvindo2 == True:
    print ("Por favor, insira um número maior que 10:")
